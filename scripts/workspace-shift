#!/usr/bin/env bash
# Swap mapped, non-pinned windows between two numeric Hyprland workspaces.
# Hyprland cannot reorder workspace numbers, so "shift" means exchanging
# window sets via an empty temp workspace.
#
# Moves are locked, snapshotted, audited, and rolled back on failure —
# including if label persist fails after windows have already moved.
# Omarchy: focus each window before moving (address-only moves are flaky).
#
# Temp workspace: under swap.lock, pick an empty id (prefer 8,9,10,7,6,3,
# then unused 11–99 which Hyprland creates on demand, then remaining 1–5),
# and re-verify it is still empty immediately before the first move. If it
# gained windows, pick another or abort. After every move phase and before
# labels, re-snapshot and fail closed on drift (then roll windows back and
# do not swap labels).
set -uo pipefail

usage() {
  echo "usage: $(basename "$0") left|right" >&2
  echo "       $(basename "$0") swap SRC DEST" >&2
  exit 2
}

NOTIFY_GLYPH=$'\U000f08ac'
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SAFE_IO="${SCRIPT_DIR}/safe_io.py"
WITH_TIMEOUT="${SCRIPT_DIR}/with-timeout"
HYPR_MAX_BYTES=2097152
HYPR_TIMEOUT=5
MAX_CLIENTS=256
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-shift"
CONFIG_PATH="${HOME}/.config/omarchy/workspace-shift.json"
_WS_LOCK_HELD=0

notify() {
  local msg="$1"
  local timeout="${2:-1500}"
  "$WITH_TIMEOUT" 5 omarchy-notification-send -g "$NOTIFY_GLYPH" "$msg" -t "$timeout" >/dev/null 2>&1 || true
}

# systemd-run --user --pipe + RuntimeMaxSec + SIGKILL, producer-side head -c.
hypr_json() {
  "$WITH_TIMEOUT" "$HYPR_TIMEOUT" \
    sh -c 'hyprctl "$@" | head -c '"${HYPR_MAX_BYTES}" sh "$@"
}

hypr_dispatch() {
  "$WITH_TIMEOUT" "$HYPR_TIMEOUT" hyprctl dispatch "$@"
}

jq_run() {
  "$WITH_TIMEOUT" "$HYPR_TIMEOUT" jq "$@"
}

emit_status() {
  # emit_status OK ERROR SRC DEST ROLLED
  local ok="$1" error="$2" src="$3" dest="$4" rolled="${5:-}"
  if [[ -n "$rolled" ]]; then
    jq_run -nc --argjson ok "$ok" --arg error "$error" --argjson src "$src" --argjson dest "$dest" --argjson rolled_back "$rolled" \
      '{ok:$ok,src:$src,dest:$dest} + (if $error != "" then {error:$error} else {} end) + {rolled_back:$rolled_back}'
  else
    jq_run -nc --argjson ok "$ok" --arg error "$error" --argjson src "$src" --argjson dest "$dest" \
      '{ok:$ok,src:$src,dest:$dest} + (if $error != "" then {error:$error} else {} end)'
  fi
}

valid_ws() {
  [[ "$1" =~ ^[1-9]$|^10$ ]]
}

valid_move_ws() {
  [[ "$1" =~ ^[1-9]$|^[1-9][0-9]$ ]]
}

valid_addr() {
  [[ "$1" =~ ^0x[0-9a-fA-F]+$ ]]
}

clients_within_cap() {
  local raw="$1"
  local n
  if (( ${#raw} < 2 || ${#raw} >= HYPR_MAX_BYTES )); then
    return 1
  fi
  n="$(jq_run 'if type=="array" then length else empty end' <<<"$raw")" || return 1
  if [[ -z "$n" || ! "$n" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if (( n > MAX_CLIENTS )); then
    return 2
  fi
  return 0
}

load_clients_json() {
  local raw rc
  raw="$(hypr_json clients -j)" || return 1
  clients_within_cap "$raw"
  rc=$?
  if (( rc != 0 )); then
    return "$rc"
  fi
  printf '%s' "$raw"
  return 0
}

snapshot_clients_from_raw() {
  local raw="$1" src="$2" dest="$3"
  jq_run -c --argjson src "$src" --argjson dest "$dest" '
    [
      .[]?
      | select(.mapped == true and ((.pinned // false) | not))
      | select(.workspace.id == $src or .workspace.id == $dest)
      | select((.address | type) == "string" and (.address | test("^0x[0-9a-fA-F]+$")))
      | {address, workspace: .workspace.id}
    ]
  ' <<<"$raw"
}

clients_from_snap() {
  local snap="$1" ws="$2"
  jq_run -r --argjson ws "$ws" '
    .[] | select(.workspace == $ws) | .address
  ' <<<"$snap"
}

# expected_json maps address -> workspace id that each snapshotted client should occupy.
expected_from_snap() {
  local snap="$1" src="$2" dest="$3" src_to="$4" dest_to="$5"
  jq_run -c --argjson src "$src" --argjson dest "$dest" --argjson src_to "$src_to" --argjson dest_to "$dest_to" '
    reduce .[] as $c ({};
      if $c.workspace == $src then .[$c.address] = $src_to
      elif $c.workspace == $dest then .[$c.address] = $dest_to
      else . end)
  ' <<<"$snap"
}

# Fail closed unless: every snapshotted address is on its expected workspace,
# and src/dest/temp hold no unexpected mapped non-pinned clients.
audit_clients() {
  local raw="$1"
  local expected="$2"
  local src="$3"
  local dest="$4"
  local temp="${5:-0}"
  jq_run -e --argjson expected "$expected" --argjson src "$src" --argjson dest "$dest" --argjson temp "$temp" '
    def mapped:
      [.[]?
       | select(.mapped == true and ((.pinned // false) | not))
       | select((.address | type) == "string" and (.address | test("^0x[0-9a-fA-F]+$")))];
    def rooms:
      if $temp == 0 then [$src, $dest] else [$src, $dest, $temp] end;
    (mapped) as $m
    | ([$expected | keys[]] | all(
        . as $a
        | ($m | map(select(.address == $a)) | length == 1)
          and (($m | map(select(.address == $a))[0].workspace.id) == $expected[$a])
      ))
    and ($m
         | map(select(.workspace.id as $w | rooms | index($w) != null))
         | all($expected[.address] != null))
  ' <<<"$raw" >/dev/null
}

focus_workspace() {
  local ws="$1"
  hypr_dispatch "hl.dsp.focus({ workspace = \"${ws}\" })" >/dev/null || true
}

move_addr() {
  local addr="$1"
  local dest="$2"
  local out now raw
  valid_addr "$addr" || return 1
  valid_move_ws "$dest" || return 1
  hypr_dispatch "hl.dsp.focus({ window = \"address:${addr}\" })" >/dev/null || return 1
  sleep 0.03
  out="$(hypr_dispatch "hl.dsp.window.move({ workspace = \"${dest}\", follow = false })" 2>&1)" || return 1
  [[ "$out" == "ok" ]] || return 1
  sleep 0.03
  raw="$(hypr_json clients -j)" || return 1
  now="$(jq_run -r --arg a "$addr" '
    .[] | select(.address == $a) | .workspace.id | tostring
  ' <<<"$raw")" || return 1
  [[ "$now" == "$dest" ]]
}

rollback_snapshot() {
  local snap="$1"
  local addr ws fail=0
  while IFS=$'\t' read -r addr ws; do
    [[ -n "${addr:-}" && -n "${ws:-}" ]] || continue
    valid_addr "$addr" || continue
    valid_ws "$ws" || continue
    move_addr "$addr" "$ws" || fail=1
  done < <(jq_run -r '.[] | [.address, (.workspace|tostring)] | @tsv' <<<"$snap")
  return "$fail"
}

workspace_client_count() {
  local ws="$1" raw="$2"
  jq_run --argjson ws "$ws" '
    [.[] | select(.workspace.id == $ws)] | length
  ' <<<"$raw"
}

temp_is_empty() {
  local ws="$1" raw count
  raw="$(load_clients_json)" || return 1
  count="$(workspace_client_count "$ws" "$raw")" || return 1
  [[ "$count" == "0" ]]
}

# Prefer scratch 8/9/10 then 7,6,3; then unused high ids 11–99 (claimed on
# demand); then remaining 1–5. Caller re-verifies emptiness before use.
pick_temp_candidate() {
  local src="$1" dest="$2" candidate count raw
  raw="$(load_clients_json)" || return 1
  local -a candidates=()
  for candidate in 8 9 10 7 6 3 5 4 2 1; do
    if (( candidate == src || candidate == dest )); then
      continue
    fi
    candidates+=("$candidate")
  done
  for candidate in $(seq 11 99); do
    if (( candidate == src || candidate == dest )); then
      continue
    fi
    candidates+=("$candidate")
  done
  for candidate in "${candidates[@]}"; do
    count="$(workspace_client_count "$candidate" "$raw")" || continue
    if [[ "$count" == "0" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

claim_temp() {
  local src="$1" dest="$2" candidate tries=0
  while (( tries < 20 )); do
    tries=$((tries + 1))
    candidate="$(pick_temp_candidate "$src" "$dest" || true)"
    if [[ -z "$candidate" ]]; then
      return 1
    fi
    if temp_is_empty "$candidate"; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

acquire_lock() {
  local src="${1:-0}" dest="${2:-0}" status=""
  if (( _WS_LOCK_HELD )); then
    return 0
  fi
  coproc _WS_LOCK {
    python3 "$SAFE_IO" hold-lock --timeout 15 --state-dir "$STATE_DIR" --name swap.lock
  }
  if [[ -z "${_WS_LOCK[0]:-}" ]]; then
    emit_status false "lock-failed" "$src" "$dest"
    return 1
  fi
  if ! IFS= read -r -t 16 status <&"${_WS_LOCK[0]}"; then
    emit_status false "lock-timeout" "$src" "$dest"
    return 1
  fi
  if [[ "$status" != "ok" ]]; then
    emit_status false "lock-failed" "$src" "$dest"
    return 1
  fi
  _WS_LOCK_HELD=1
  return 0
}

fail_swap() {
  local code="$1" src="$2" dest="$3" focus_after="$4" extra="${5:-}"
  notify "Workspace shift failed" 2000
  focus_workspace "$focus_after"
  if [[ -n "$extra" ]]; then
    emit_status false "$code" "$src" "$dest" "$extra"
  else
    emit_status false "$code" "$src" "$dest"
  fi
  return 1
}

abort_with_rollback() {
  local code="$1" src="$2" dest="$3" focus_after="$4" snap="$5"
  local rolled=true
  if ! rollback_snapshot "$snap"; then
    rolled=false
  fi
  notify "Workspace shift failed" 2000
  focus_workspace "$focus_after"
  emit_status false "$code" "$src" "$dest" "$rolled"
  return 1
}

restore_labels() {
  local prev="$1"
  if [[ -z "$prev" ]]; then
    return 0
  fi
  printf '%s' "$prev" | "$WITH_TIMEOUT" 5 python3 "$SAFE_IO" write --max-bytes 65536 "$CONFIG_PATH" >/dev/null 2>&1 || true
}

move_group() {
  local dest="$1"
  shift
  local addr
  for addr in "$@"; do
    [[ -n "${addr:-}" ]] || continue
    move_addr "$addr" "$dest" || return 1
  done
  return 0
}

audit_or_fail() {
  local raw expected src dest temp
  expected="$1"
  src="$2"
  dest="$3"
  temp="${4:-0}"
  raw="$(load_clients_json)" || return 1
  audit_clients "$raw" "$expected" "$src" "$dest" "$temp"
}

swap_workspaces() {
  local src="$1"
  local dest="$2"
  local focus_after="${3:-$dest}"

  if ! valid_ws "$src" || ! valid_ws "$dest"; then
    echo "workspace ids must be 1..10" >&2
    emit_status false "invalid-id" "${src:-0}" "${dest:-0}"
    return 2
  fi
  if (( src == dest )); then
    emit_status true "" "$src" "$dest"
    return 0
  fi

  acquire_lock "$src" "$dest" || return 1

  local raw="" rc=0
  raw="$(load_clients_json)"
  rc=$?
  if (( rc == 2 )); then
    fail_swap "too-many-clients" "$src" "$dest" "$focus_after"
    return 1
  fi
  if (( rc != 0 )) || [[ -z "$raw" ]]; then
    fail_swap "snapshot-failed" "$src" "$dest" "$focus_after"
    return 1
  fi

  local snap=""
  snap="$(snapshot_clients_from_raw "$raw" "$src" "$dest")" || {
    fail_swap "snapshot-failed" "$src" "$dest" "$focus_after"
    return 1
  }

  local -a SRC_ADDRS=() DEST_ADDRS=()
  mapfile -t SRC_ADDRS < <(clients_from_snap "$snap" "$src")
  mapfile -t DEST_ADDRS < <(clients_from_snap "$snap" "$dest")

  local TEMP=0
  local need_temp=0
  if (( ${#SRC_ADDRS[@]} > 0 && ${#DEST_ADDRS[@]} > 0 )); then
    need_temp=1
  fi

  local exp_final exp_mid
  exp_final="$(expected_from_snap "$snap" "$src" "$dest" "$dest" "$src")" || {
    fail_swap "snapshot-failed" "$src" "$dest" "$focus_after"
    return 1
  }

  if (( need_temp )); then
    TEMP="$(claim_temp "$src" "$dest" || true)"
    if [[ -z "$TEMP" ]]; then
      notify "No empty workspace for swap" 2000
      focus_workspace "$focus_after"
      emit_status false "no-temp" "$src" "$dest"
      return 1
    fi
    if ! temp_is_empty "$TEMP"; then
      notify "No empty workspace for swap" 2000
      focus_workspace "$focus_after"
      emit_status false "no-temp" "$src" "$dest"
      return 1
    fi
    if ! move_group "$TEMP" "${SRC_ADDRS[@]}"; then
      abort_with_rollback "move-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    fi
    exp_mid="$(expected_from_snap "$snap" "$src" "$dest" "$TEMP" "$dest")" || {
      abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    }
    if ! audit_or_fail "$exp_mid" "$src" "$dest" "$TEMP"; then
      abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    fi
    if ! move_group "$src" "${DEST_ADDRS[@]}"; then
      abort_with_rollback "move-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    fi
    exp_mid="$(expected_from_snap "$snap" "$src" "$dest" "$TEMP" "$src")" || {
      abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    }
    if ! audit_or_fail "$exp_mid" "$src" "$dest" "$TEMP"; then
      abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    fi
    if ! move_group "$dest" "${SRC_ADDRS[@]}"; then
      abort_with_rollback "move-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    fi
  else
    if ! move_group "$dest" "${SRC_ADDRS[@]}"; then
      abort_with_rollback "move-failed" "$src" "$dest" "$focus_after" "$snap"
      return 1
    fi
    if (( ${#DEST_ADDRS[@]} > 0 )); then
      exp_mid="$(expected_from_snap "$snap" "$src" "$dest" "$dest" "$dest")" || {
        abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
        return 1
      }
      if ! audit_or_fail "$exp_mid" "$src" "$dest" 0; then
        abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
        return 1
      fi
      if ! move_group "$src" "${DEST_ADDRS[@]}"; then
        abort_with_rollback "move-failed" "$src" "$dest" "$focus_after" "$snap"
        return 1
      fi
    fi
  fi

  if ! audit_or_fail "$exp_final" "$src" "$dest" "${TEMP:-0}"; then
    abort_with_rollback "audit-failed" "$src" "$dest" "$focus_after" "$snap"
    return 1
  fi

  local prev_labels=""
  prev_labels="$("$WITH_TIMEOUT" 5 python3 "$SAFE_IO" read --max-bytes 65536 "$CONFIG_PATH" 2>/dev/null || true)"

  if ! "$WITH_TIMEOUT" 5 python3 "$SAFE_IO" swap-labels "$src" "$dest" --config "$CONFIG_PATH"; then
    restore_labels "$prev_labels"
    local rolled=true
    if ! rollback_snapshot "$snap"; then
      rolled=false
    fi
    notify "Workspace shift labels failed" 2000
    focus_workspace "$focus_after"
    emit_status false "label-failed" "$src" "$dest" "$rolled"
    return 1
  fi

  focus_workspace "$focus_after"
  emit_status true "" "$src" "$dest"
  return 0
}

CMD="${1:-}"
case "$CMD" in
  left|right)
    CURRENT="$(hypr_json activeworkspace -j | jq_run -r '.id')"
    valid_ws "${CURRENT:-}" || exit 1
    if [[ "$CMD" == "left" ]]; then
      NEIGHBOR=$((CURRENT - 1))
      if (( NEIGHBOR < 1 )); then
        notify "Already at workspace 1" 1500
        emit_status true "at-edge" "$CURRENT" "$CURRENT"
        exit 0
      fi
    else
      NEIGHBOR=$((CURRENT + 1))
      if (( NEIGHBOR > 10 )); then
        notify "Already at workspace 10" 1500
        emit_status true "at-edge" "$CURRENT" "$CURRENT"
        exit 0
      fi
    fi
    raw="$(load_clients_json)"
    rc=$?
    if (( rc == 2 )); then
      emit_status false "too-many-clients" "$CURRENT" "$NEIGHBOR"
      exit 1
    fi
    if (( rc != 0 )) || [[ -z "${raw:-}" ]]; then
      emit_status false "snapshot-failed" "$CURRENT" "$NEIGHBOR"
      exit 1
    fi
    mapfile -t CURRENT_ADDRS < <(
      jq_run -r --argjson ws "$CURRENT" '
        .[]
        | select(.workspace.id == $ws and .mapped == true and ((.pinned // false) | not))
        | select((.address | type) == "string" and (.address | test("^0x[0-9a-fA-F]+$")))
        | .address
      ' <<<"$raw"
    )
    if ((${#CURRENT_ADDRS[@]} == 0)); then
      focus_workspace "$NEIGHBOR"
      emit_status true "" "$CURRENT" "$NEIGHBOR"
      exit 0
    fi
    swap_workspaces "$CURRENT" "$NEIGHBOR" "$NEIGHBOR" || exit $?
    notify "Workspace ${CURRENT} → ${NEIGHBOR}" 1200
    ;;
  swap)
    SRC="${2:-}"
    DEST="${3:-}"
    [[ -n "$SRC" && -n "$DEST" ]] || usage
    ORIG="$(hypr_json activeworkspace -j | jq_run -r '.id' || true)"
    valid_ws "${ORIG:-}" || ORIG="$DEST"
    swap_workspaces "$SRC" "$DEST" "$ORIG" || exit $?
    ;;
  *)
    usage
    ;;
esac
