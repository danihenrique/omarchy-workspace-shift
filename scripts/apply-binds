#!/usr/bin/env python3
"""Write or strip the Hyprland bind block owned by Workspace Shift."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys

import safe_io

PLUGIN_ID = "io.github.danihenrique.workspace-shift"
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SHIFT = os.path.join(PLUGIN_DIR, "scripts", "workspace-shift")
BEGIN = f"-- BEGIN {PLUGIN_ID}"
END = f"-- END {PLUGIN_ID}"
DEFAULT_LEFT = safe_io.DEFAULT_LEFT
DEFAULT_RIGHT = safe_io.DEFAULT_RIGHT
EXTRA_LEFT = "SUPER + less"
EXTRA_RIGHT = "SUPER + greater"
BINDINGS_MAX = safe_io.BINDINGS_MAX_BYTES
SCREENS_BEGIN = "-- BEGIN im0001gt.screens"
INTERIOR_RE = re.compile(
    r'^(?:hl\.unbind\("(?:[^"\\]|\\.)*"\)'
    r'|o\.bind\("(?:[^"\\]|\\.)*", "(?:[^"\\]|\\.)*", "(?:[^"\\]|\\.)*"\))$'
)


def bindings_path() -> str:
    override = os.environ.get("WORKSPACE_SHIFT_BINDINGS")
    if override and os.path.isabs(override):
        return override
    return os.path.expanduser("~/.config/hypr/bindings.lua")


def config_path() -> str:
    return safe_io.CONFIG_DEFAULT


def load_config() -> dict:
    try:
        return safe_io.load_config(config_path())
    except OSError:
        return safe_io.sanitize_config({})


def save_config(data: dict) -> None:
    safe_io.save_config(data, config_path())


def lua_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def sanitize_bind(value: str | None, default: str) -> str:
    return safe_io.sanitize_shortcut(value, default)


def managed_block(left: str, right: str) -> str:
    left = sanitize_bind(left, DEFAULT_LEFT)
    right = sanitize_bind(right, DEFAULT_RIGHT)
    keys: list[str] = []
    for key in (left, right, EXTRA_LEFT, EXTRA_RIGHT):
        if key not in keys:
            keys.append(key)
    lines = [BEGIN]
    for key in keys:
        lines.append(f'hl.unbind("{lua_escape(key)}")')
    lines.append(
        f'o.bind("{lua_escape(left)}", "Shift workspace left", "{lua_escape(SHIFT)} left")'
    )
    lines.append(
        f'o.bind("{lua_escape(right)}", "Shift workspace right", "{lua_escape(SHIFT)} right")'
    )
    if left != EXTRA_LEFT:
        lines.append(
            f'o.bind("{lua_escape(EXTRA_LEFT)}", "Shift workspace left", "{lua_escape(SHIFT)} left")'
        )
    if right != EXTRA_RIGHT:
        lines.append(
            f'o.bind("{lua_escape(EXTRA_RIGHT)}", "Shift workspace right", "{lua_escape(SHIFT)} right")'
        )
    lines.append(END)
    return "\n".join(lines) + "\n"


def split_managed(text: str) -> tuple[str, str | None, str]:
    """Split out a unique, structurally validated managed block. Fail closed otherwise."""
    lines = text.splitlines(keepends=True)
    begins: list[int] = []
    ends: list[int] = []
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped == BEGIN:
            begins.append(i)
        elif stripped == END:
            ends.append(i)
    if not begins and not ends:
        return text, None, ""
    if len(begins) != 1 or len(ends) != 1:
        raise ValueError("managed bind block is not unique")
    begin_at, end_at = begins[0], ends[0]
    if end_at <= begin_at:
        raise ValueError("managed bind block is malformed")
    for line in lines[begin_at + 1 : end_at]:
        stripped = line.strip()
        if not stripped:
            continue
        if stripped in (BEGIN, END) or not INTERIOR_RE.fullmatch(stripped):
            raise ValueError("managed bind block contains unexpected content")
    before = "".join(lines[:begin_at])
    block = "".join(lines[begin_at : end_at + 1])
    after = "".join(lines[end_at + 1 :])
    return before, block, after


def strip_legacy_exact(text: str) -> str:
    """Delete only lines that contain this plugin's absolute script path."""
    kept: list[str] = []
    for line in text.splitlines(True):
        if SHIFT in line:
            continue
        kept.append(line)
    out = "".join(kept)
    out = re.sub(r"\n{3,}", "\n\n", out)
    if not out.endswith("\n"):
        out += "\n"
    return out


def compose_bindings(text: str, block: str, remove_only: bool, migrate_legacy: bool) -> str:
    before, existing, after = split_managed(text)
    if migrate_legacy:
        before = strip_legacy_exact(before)
        after = strip_legacy_exact(after)
    if remove_only:
        combined = before.rstrip("\n")
        rest = after.lstrip("\n")
        if combined and rest:
            text = combined + "\n\n" + rest
        else:
            text = combined + rest
        if text and not text.endswith("\n"):
            text += "\n"
        return text or "\n"
    insertion = block if block.endswith("\n") else block + "\n"
    if existing is not None:
        glue = "" if after.startswith("\n") or not after else "\n"
        text = before + insertion + glue + after
        if not text.endswith("\n"):
            text += "\n"
        return text
    body = before + after
    if SCREENS_BEGIN in body:
        text = body.replace(SCREENS_BEGIN, insertion + "\n" + SCREENS_BEGIN, 1)
    else:
        text = body.rstrip() + "\n\n" + insertion
    if not text.endswith("\n"):
        text += "\n"
    return text


def write_bindings(block: str, remove_only: bool, migrate_legacy: bool) -> None:
    def transform(text: str) -> str:
        return compose_bindings(text, block, remove_only, migrate_legacy)

    safe_io.rmw_text(bindings_path(), transform, max_bytes=BINDINGS_MAX, missing_ok=False)


def apply_config_then_bindings(cfg: dict, block: str, remove_only: bool, migrate_legacy: bool) -> None:
    """Write config first, then bindings; restore config if the bindings write fails."""
    prev_cfg: bytes | None = None
    cfg_written = False
    if not remove_only:
        try:
            prev_cfg = safe_io.read_bytes(config_path(), safe_io.CONFIG_MAX_BYTES)
        except OSError:
            prev_cfg = b""
        save_config(cfg)
        cfg_written = True
    try:
        write_bindings(block, remove_only, migrate_legacy)
    except Exception:
        if cfg_written:
            try:
                safe_io.write_bytes(
                    config_path(),
                    prev_cfg or b"",
                    max_bytes=safe_io.CONFIG_MAX_BYTES,
                )
            except OSError:
                pass
        raise


def run_timeout(args: list[str], seconds: int = 5) -> subprocess.CompletedProcess:
    wrap = os.path.join(PLUGIN_DIR, "scripts", "with-timeout")
    if os.path.isfile(wrap) and os.access(wrap, os.X_OK):
        cmd = [wrap, str(seconds), *args]
    else:
        cmd = ["timeout", "--kill-after=2s", f"{seconds}s", *args]
    return subprocess.run(cmd, check=False)


def reload() -> None:
    run_timeout(["hyprctl", "reload"])


def main() -> int:
    parser = argparse.ArgumentParser(description="Install or remove Workspace Shift Hypr binds")
    parser.add_argument("--remove", action="store_true", help="Strip the managed bind block")
    parser.add_argument("--left", help="Omarchy bind syntax for shift left")
    parser.add_argument("--right", help="Omarchy bind syntax for shift right")
    parser.add_argument("--no-reload", action="store_true")
    parser.add_argument(
        "--migrate-legacy",
        action="store_true",
        help="Also delete lines outside the managed block that contain this plugin's absolute script path",
    )
    parser.add_argument(
        "--set-label",
        nargs=2,
        metavar=("ID", "TEXT"),
        help="Set or clear one workspace label in plugin config (empty TEXT clears)",
    )
    args = parser.parse_args()

    try:
        if args.set_label is not None:
            ws, text = args.set_label
            safe_io.set_label_in_config(ws, text, config_path())
            return 0

        if args.remove:
            apply_config_then_bindings({}, "", remove_only=True, migrate_legacy=args.migrate_legacy)
            if not args.no_reload:
                reload()
            return 0

        cfg = load_config()
        left = sanitize_bind(
            args.left if args.left is not None else cfg.get("shortcutLeft"),
            DEFAULT_LEFT,
        )
        right = sanitize_bind(
            args.right if args.right is not None else cfg.get("shortcutRight"),
            DEFAULT_RIGHT,
        )
        cfg["shortcutLeft"] = left
        cfg["shortcutRight"] = right
        if not isinstance(cfg.get("labels"), dict):
            cfg["labels"] = {}
        apply_config_then_bindings(
            cfg,
            managed_block(left, right),
            remove_only=False,
            migrate_legacy=args.migrate_legacy,
        )
        if not args.no_reload:
            reload()
        return 0
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
